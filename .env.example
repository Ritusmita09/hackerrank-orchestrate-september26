# --- Application ---
# local | test | staging | production
APP_ENV=local

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database ---
# Production target:
#   DATABASE_URL=postgresql+psycopg://finagent:CHANGE_ME@localhost:5432/finagent
# Development / test fallback (no server required):
DATABASE_URL=sqlite:///./ai_financial_agent.db

# --- AI layer (Phase 3 onward; not required in Phase 2) ---
# none | omniroute | (future adapters)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
# NEVER commit real keys. Provide via environment / secret manager only.
ANTHROPIC_API_KEY=
LLM_MAX_STEPS_PER_TURN=5
LLM_MAX_TOKENS_PER_TURN=4000

# --- OmniRoute (local model-routing layer, Phase 4) ---
# OmniRoute exposes the Anthropic Messages API locally; the app talks only to
# this endpoint, never to a specific model vendor.
OMNIROUTE_BASE_URL=http://localhost:20128
# Provider-prefixed model id as listed in the OmniRoute catalog.
OMNIROUTE_MODEL=agentrouter/deepseek-v4-flash
# Optional: dedicated multimodal model for document extraction turns.
# Falls back to OMNIROUTE_MODEL when empty.
OMNIROUTE_EXTRACTION_MODEL=
# NEVER commit a real token. Provide via environment / secret manager only.
OMNIROUTE_API_KEY=

# --- Ingestion safety limits ---
MAX_UPLOAD_BYTES=5242880
ALLOWED_MIME_TYPES=text/csv,application/pdf,image/png,image/jpeg,text/plain
MAX_MESSAGE_CHARS=10000
MAX_CSV_ROWS=10000
# Root directory for uploaded document bytes (documents table stores metadata only).
STORAGE_DIR=storage

# --- Forecasting defaults ---
DEFAULT_HORIZON_DAYS=90
